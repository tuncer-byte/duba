{
  "expo": {
    "name": "Duba",
    "slug": "duba",
    "scheme": "duba",
    "version": "0.9.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.duba.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.duba.app",
      "adaptiveIcon": {
        "backgroundColor": "#168D3F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#168D3F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "description": "Duba: B sınıfı ehliyet yazılı sınavına hazırlık — deneme sınavları, konu anlatımı, trafik işaretleri.",
    "locales": {}
  }
}