{
  "expo": {
    "name": "Duba",
    "slug": "duba",
    "scheme": "duba",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tunadev58.duba",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tunadev58.duba",
      "adaptiveIcon": {
        "backgroundColor": "#168D3F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#168D3F"
        }
      ],
      "expo-sharing",
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "Duba, sesli cevap özelliği için mikrofonu kullanır.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-localization",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Duba, kayıtlı bilgilerini korumak için Face ID kullanır."
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#168D3F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "description": "Duba: B sınıfı ehliyet yazılı sınavına hazırlık — deneme sınavları, konu anlatımı, trafik işaretleri.",
    "locales": {},
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4abaf609-1f1b-4698-a2df-54724ef496eb"
      }
    },
    "owner": "tunadev58",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/4abaf609-1f1b-4698-a2df-54724ef496eb",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
